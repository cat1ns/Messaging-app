  <property name="styleSheet">
   <string notr="true">QDialog#UserLoginClass {
	background: #efefef;
	font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QFrame#frame_TitleBar {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4b47b9, stop:1 #249c86);
}

QLabel#label_TitleBarText {
	color: #ffffff;
	font-size: 14px;
	background: transparent;
}

QLabel#label_Title {
	color: #4e81b3;
	font-size: 18px;
	font-weight: 500;
	background: transparent;
}

QFrame#frame_Login {
	background: #f2f2f2;
	border: 1px solid #c8c0ff;
	border-radius: 12px;
}

QLabel#label_GroupLogin {
	background: #e8e5f5;
	color: #5f58cb;
	font-size: 14px;
	font-weight: 600;
	padding-left: 20px;
	border-top-left-radius: 12px;
	border-top-right-radius: 12px;
}

QLabel#label_User,
QLabel#label_Pass {
	color: #5550c5;
	font-size: 13px;
	background: transparent;
}

QLineEdit {
	background: #efefef;
	color: #303090;
	border: 1px solid #bdb7f5;
	border-radius: 6px;
	padding: 4px 10px;
	font-size: 13px;
	selection-background-color: #d7ebe5;
}

QLineEdit:focus {
	border-color: #5f58cb;
}

QPushButton {
	border-radius: 8px;
	min-height: 38px;
	font-size: 18px;
	font-weight: 500;
}

QPushButton#pushButton_OK {
	color: #ffffff;
	border: none;
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5450c9, stop:1 #22a486);
}

QPushButton#pushButton_OK:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #635ee0, stop:1 #28b997);
}

QPushButton#pushButton_Add {
	color: #ffffff;
	border: none;
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #249c86, stop:1 #4b47b9);
}

QPushButton#pushButton_Add:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #28b997, stop:1 #635ee0);
}

QPushButton#pushButton_Cannel {
	color: #5550c5;
	background: #f3f3f3;
	border: 1px solid #c8c0ff;
}

QPushButton#pushButton_Cannel:hover {
	background: #e8e5f5;
}

QPushButton:disabled {
	color: #9a98b8;
	background: #e6e6e6;
	border: 1px solid #d3d0ef;
}

QLabel#label_Status {
	color: #5550c5;
	background: transparent;
	font-size: 13px;
}
</string>
