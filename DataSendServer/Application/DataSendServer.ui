}

QLabel#label_Title {
    color: #4e81b3;
    font-size: 18px;
    font-weight: 500;
    background: transparent;
}

QFrame#frame_Target,
QFrame#frame_Timer,
QFrame#frame_Send,
QFrame#frame_Reply {
    background: #f2f2f2;
    border: 1px solid #c8c0ff;
    border-radius: 12px;
}

QLabel#label_GroupTarget {
    background: #e8e5f5;
    color: #5f58cb;
    font-size: 14px;
    font-weight: 600;
    padding-left: 20px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QLabel#label_GroupTimer,
QLabel#label_GroupSend,
QLabel#label_GroupReply {
    background: #d7ebe5;
    color: #2e8f79;
    font-size: 14px;
    font-weight: 600;
    padding-left: 20px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QLabel#label,
QLabel#label_2,
QLabel#label_3,
QLabel#label_4,
QLabel#label_5 {
    color: #5550c5;
    font-size: 13px;
    background: transparent;
}

QLineEdit,
QSpinBox,
QComboBox,
QTextEdit {
    background: #efefef;
    color: #303090;
    border: 1px solid #bdb7f5;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 13px;
    selection-background-color: #d7ebe5;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus,
QTextEdit:focus {
    border-color: #5f58cb;
}

QComboBox::drop-down {
    width: 24px;
    border-left: 1px solid #c8c0ff;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #303090;
    border: 1px solid #bdb7f5;
    selection-background-color: #d7ebe5;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 18px;
    border: none;
    background: transparent;
}

QLabel#label_interval_hint {
    color: #74b9a4;
    font-size: 13px;
    background: transparent;
}

QTextEdit#text_send {
    font-size: 14px;
}

QTextEdit#textEdit_ReplyDisplay {
    background: #e9ecec;
    line-height: 150%;
}

QPushButton {
    border-radius: 8px;
    min-height: 38px;
    font-size: 18px;
    font-weight: 500;
}

QPushButton#pushButton_send {
    color: #ffffff;
    border: none;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5450c9, stop:1 #22a486);
}

QPushButton#pushButton_send:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #635ee0, stop:1 #28b997);
}

QPushButton#pushButton_stop {
    color: #5550c5;
    background: #f3f3f3;
    border: 1px solid #c8c0ff;
}

QPushButton#pushButton_stop:hover {
    background: #e8e5f5;
}

QPushButton:disabled {
    color: #9a98b8;
    background: #e6e6e6;
    border: 1px solid #d3d0ef;
}

QLabel#label_ErrorMessage {
    color: #5550c5;
    background: #efefef;
    border: 1px solid #c8c0ff;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
}

QProgressBar {
    background: #e4e4e4;
    border: none;
    border-radius: 4px;
    height: 8px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #544fc9, stop:1 #56d0b2);
    border-radius: 4px;
