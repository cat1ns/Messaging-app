  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: #E9E9E9;
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, sans-serif;
}

QWidget#centralWidget {
    background: #E9E9E9;
}

QFrame#frameWindow {
    background: #EFEFEF;
    border: 1px solid #C8C0FF;
    border-radius: 12px;
}

QFrame#frameTitleBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4B47B9, stop:1 #249C86);
    border: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QLabel#label_TitleBar {
    color: #FFFFFF;
    font-size: 14px;
    background: transparent;
}

QLabel#label_Dot1,
QLabel#label_Dot2,
QLabel#label_Dot3 {
    min-width: 11px;
    max-width: 11px;
    min-height: 11px;
    max-height: 11px;
    border-radius: 5px;
}

QLabel#label_Dot1 { background: #FF9F75; }
QLabel#label_Dot2 { background: #F0C76D; }
QLabel#label_Dot3 { background: #B9E6CF; }

QLabel#label_Title {
    color: #4E81B3;
    font-size: 18px;
    font-weight: 500;
    background: transparent;
}

QFrame[class=&quot;card&quot;] {
    background: #F2F2F2;
    border: 1px solid #C8C0FF;
    border-radius: 12px;
}

QFrame[class=&quot;cardHeaderPurple&quot;] {
    background: #E8E5F5;
    border: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QFrame[class=&quot;cardHeaderGreen&quot;] {
    background: #D7EBE5;
    border: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QLabel[class=&quot;cardHeaderTextPurple&quot;] {
    color: #5F58CB;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

QLabel[class=&quot;cardHeaderTextGreen&quot;] {
    color: #2E8F79;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

QLabel[class=&quot;fieldLabel&quot;] {
    color: #5550C5;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

QLineEdit,
QTextEdit {
    background: #EFEFEF;
    color: #303090;
    border: 1px solid #BDB7F5;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
}

QComboBox {
    background: #EFEFEF;
    color: #303090;
    border: 1px solid #BDB7F5;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 13px;
    selection-background-color: #D7EBE5;
}

QTextEdit#textEdit_Receiver {
    background: #E9ECEC;
    line-height: 150%;
}

QLineEdit:focus,
QTextEdit:focus {
    border-color: #5F58CB;
    background: #F7F7FF;
}

QComboBox:focus {
    border-color: #5F58CB;
}

QComboBox::drop-down {
    width: 24px;
    border-left: 1px solid #C8C0FF;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #303090;
    border: 1px solid #BDB7F5;
    selection-background-color: #D7EBE5;
}

QRadioButton {
    color: #5550C5;
    font-size: 13px;
    spacing: 5px;
    background: transparent;
}

QRadioButton::indicator {
    width: 13px;
    height: 13px;
    border-radius: 7px;
    border: 1px solid #BDB7F5;
    background: #EFEFEF;
}

QRadioButton::indicator:checked {
    background: #5550C5;
    border: 2px solid #EFEFEF;
}

QPushButton {
    color: #FFFFFF;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #5450C9, stop:1 #22A486);
    border: none;
    border-radius: 8px;
    font-size: 18px;
    font-weight: 500;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6762D8, stop:1 #28B997);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4541B3, stop:1 #1E8F76);
}

QPushButton#pushButton_Stop {
    color: #5550C5;
    background: #F3F3F3;
    border: 1px solid #C8C0FF;
}

QPushButton#pushButton_Stop:hover {
    background: #E8E5F5;
}

QPushButton:disabled {
    color: #9A9AB8;
    background: #E1E1E1;
}
</string>
